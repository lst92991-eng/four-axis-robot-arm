+
+// Software 128-bit bitboard arithmetic restored from Pikafish-2023-03-05
+// (commit 4762ca3), under the project's GPL-3.0-or-later license.
+// Used only on 32-bit GNU targets without native __int128.
+#ifndef UINT128_H_INCLUDED
+#define UINT128_H_INCLUDED
+#include <cstdint>
+namespace Stockfish {
+struct u128 {
+    uint64_t b64[2];
+
+    constexpr u128() : b64{ 0, 0 } {}
+    constexpr u128(uint64_t i) : b64{ 0, i } {}
+    constexpr u128(uint64_t hi, uint64_t lo) : b64{ hi, lo } {};
+
+    constexpr operator bool() const {
+        return b64[0] || b64[1];
+    }
+
+    constexpr operator long long unsigned() const {
+        return b64[1];
+    }
+
+    constexpr operator unsigned() const {
+        return b64[1];
+    }
+
+    constexpr u128 operator << (const unsigned int bits) const {
+        return u128(bits >= 64 ? b64[1] << (bits - 64)
+            : bits == 0 ? b64[0]
+            : ((b64[0] << bits) | (b64[1] >> (64 - bits))),
+            bits >= 64 ? 0 : b64[1] << bits);
+    }
+
+    constexpr u128 operator >> (const unsigned int bits) const {
+        return u128(bits >= 64 ? 0 : b64[0] >> bits,
+            bits >= 64 ? b64[0] >> (bits - 64)
+            : bits == 0 ? b64[1]
+            : ((b64[1] >> bits) | (b64[0] << (64 - bits))));
+    }
+
+    constexpr u128 operator << (const int bits) const {
+        return *this << unsigned(bits);
+    }
+
+    constexpr u128 operator >> (const int bits) const {
+        return *this >> unsigned(bits);
+    }
+
+    constexpr bool operator == (const u128 y) const {
+        return (b64[0] == y.b64[0]) && (b64[1] == y.b64[1]);
+    }
+
+    constexpr bool operator != (const u128 y) const {
+        return !(*this == y);
+    }
+
+    constexpr u128& operator |=(const u128 x) {
+        b64[0] |= x.b64[0];
+        b64[1] |= x.b64[1];
+        return *this;
+    }
+    constexpr u128& operator &=(const u128 x) {
+        b64[0] &= x.b64[0];
+        b64[1] &= x.b64[1];
+        return *this;
+    }
+    constexpr u128& operator ^=(const u128 x) {
+        b64[0] ^= x.b64[0];
+        b64[1] ^= x.b64[1];
+        return *this;
+    }
+
+    constexpr u128 operator ~ () const {
+        return u128(~b64[0], ~b64[1]);
+    }
+
+    constexpr u128 operator - () const {
+        return u128(-b64[0] - (b64[1] > 0), -b64[1]);
+    }
+
+    constexpr u128 operator | (const u128 x) const {
+        return u128(b64[0] | x.b64[0], b64[1] | x.b64[1]);
+    }
+
+    constexpr u128 operator & (const u128 x) const {
+        return u128(b64[0] & x.b64[0], b64[1] & x.b64[1]);
+    }
+
+    constexpr u128 operator ^ (const u128 x) const {
+        return u128(b64[0] ^ x.b64[0], b64[1] ^ x.b64[1]);
+    }
+
+    constexpr u128 operator - (const u128 x) const {
+        return u128(b64[0] - x.b64[0] - (b64[1] < x.b64[1]), b64[1] - x.b64[1]);
+    }
+
+    constexpr u128 operator - (const int x) const {
+        return *this - u128(x);
+    }
+
+    constexpr u128 operator * (const u128 x) const {
+        uint64_t a_lo = (uint32_t)b64[1];
+        uint64_t a_hi = b64[1] >> 32;
+        uint64_t b_lo = (uint32_t)x.b64[1];
+        uint64_t b_hi = x.b64[1] >> 32;
+
+        uint64_t t1 = (a_hi * b_lo) + ((a_lo * b_lo) >> 32);
+        uint64_t t2 = (a_lo * b_hi) + (t1 & 0xFFFFFFFF);
+
+        return u128(b64[0] * x.b64[1] + b64[1] * x.b64[0] + (a_hi * b_hi) + (t1 >> 32) + (t2 >> 32),
+            (t2 << 32) + (a_lo * b_lo & 0xFFFFFFFF));
+    }
+};
+}  // namespace Stockfish
+#endif
